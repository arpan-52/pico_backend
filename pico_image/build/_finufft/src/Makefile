	cd /home/arpan/pico/pico_backend/pico_image/build && $(MAKE) $(MAKESILENT) -f _finufft/src/CMakeFiles/finufft.dir/build.make _finufft/src/CMakeFiles/finufft.dir/spreadinterp_3d.cpp.s
.PHONY : spreadinterp_3d.cpp.s

